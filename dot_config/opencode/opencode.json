{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "~/go/pkg/mod/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/.envrc": "deny",
      "**/.envrc.*": "deny",
      "**/.mise.local.toml": "deny",
      "**/.mise.*.local.toml": "deny",
      "**/mise.local.toml": "deny",
      "**/mise.*.local.toml": "deny",
      "**/.secrets.sh": "deny",
      "**/secrets.sh": "deny",
      "**/secrets.json": "deny",
      "**/secrets.yaml": "deny",
      "**/secrets.yml": "deny",
      "**/credentials": "deny",
      "**/credentials.json": "deny",
      "**/.aws/credentials": "deny",
      "**/.aws/config": "deny",
      "**/.netrc": "deny",
      "**/.pgpass": "deny",
      "**/terraform.tfstate": "deny",
      "**/terraform.tfstate.backup": "deny",
      "**/*.tfstate": "deny",
      "**/*.tfstate.backup": "deny",
      "**/.terraform/terraform.tfstate": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa": "deny",
      "**/id_rsa.pub": "allow",
      "**/id_ed25519": "deny",
      "**/id_ed25519.pub": "allow",
      "**/id_ecdsa": "deny",
      "**/id_dsa": "deny",
      "**/.ssh/known_hosts": "allow"
    },
    "bash": {
      "*": "allow",
      "cat *.envrc*": "deny",
      "cat *.env": "deny",
      "cat *.env.*": "deny",
      "cat *mise.local*": "deny",
      "cat *secrets.sh*": "deny",
      "cat *secrets.json*": "deny",
      "cat *credentials*": "deny",
      "cat *.pem*": "deny",
      "cat *.key*": "deny",
      "cat *id_rsa*": "deny",
      "cat *id_ed25519*": "deny",
      "cat *.aws/credentials*": "deny",
      "cat *.aws/config*": "deny",
      "cat *.netrc*": "deny",
      "cat *.tfstate*": "deny",
      "head *.tfstate*": "deny",
      "tail *.tfstate*": "deny",
      "less *.tfstate*": "deny",
      "bat *.tfstate*": "deny",
      "terraform show*": "deny",
      "tofu show*": "deny",
      "head *.envrc*": "deny",
      "head *.env": "deny",
      "head *mise.local*": "deny",
      "head *secrets*": "deny",
      "head *credentials*": "deny",
      "tail *.envrc*": "deny",
      "tail *.env": "deny",
      "tail *mise.local*": "deny",
      "tail *secrets*": "deny",
      "tail *credentials*": "deny",
      "less *.envrc*": "deny",
      "less *.env": "deny",
      "less *mise.local*": "deny",
      "bat *.envrc*": "deny",
      "bat *.env": "deny",
      "bat *mise.local*": "deny",
      "mise env*": "deny",
      "mise environment*": "deny",
      "direnv export*": "deny",
      "env": "ask",
      "printenv *AWS*": "deny",
      "printenv *SECRET*": "deny",
      "printenv *TOKEN*": "deny",
      "printenv *PASSWORD*": "deny",
      "printenv *KEY*": "deny",
      "echo $AWS_*": "deny",
      "echo $*SECRET*": "deny",
      "echo $*TOKEN*": "deny",
      "echo $*PASSWORD*": "deny"
    }
  },
  "mcp": {
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": false
    }
  }
}
